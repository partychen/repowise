include README.md README.zh.md AGENTS.md
include .github/skills/repowise/SKILL.md
include .github/skills/repowise/requirements.txt
include .github/skills/repowise/wheels/*.whl
include .github/skills/repowise/wheels/provenance.json
include .github/skills/repowise/wheels/LICENSE.PyYAML.txt
include .github/skills/repowise/references/*.md
include .github/skills/repowise/packs/__init__.py
include .github/skills/repowise/packs/*.json
include .github/skills/repowise/packs/sources/*.json
include .github/skills/repowise/scripts/main.py
include .github/skills/repowise/scripts/repowise/*.py
recursive-include docs *.md
recursive-include examples *.json *.yaml
include tools/package_skill.py
global-exclude *.py[cod]
